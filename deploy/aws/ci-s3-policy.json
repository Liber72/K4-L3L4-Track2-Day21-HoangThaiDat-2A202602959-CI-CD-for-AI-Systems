{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "LocateAndListLabBucket",
      "Effect": "Allow",
      "Action": [
        "s3:GetBucketLocation",
        "s3:ListBucket"
      ],
      "Resource": "arn:aws:s3:::income-day21-972243443873-use1",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1"
        }
      }
    },
    {
      "Sid": "ReadDvcData",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject"
      ],
      "Resource": [
        "arn:aws:s3:::income-day21-972243443873-use1/dvc/*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1"
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": [
        "s3:PutObject"
      ],
      "Resource": [
        "arn:aws:s3:::income-day21-972243443873-use1/artifacts/current/model.joblib",
        "arn:aws:s3:::income-day21-972243443873-use1/artifacts/current/report.json"
      ],
      "Sid": "PublishApprovedModelAndReport",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1"
        }
      }
    }
  ]
}
